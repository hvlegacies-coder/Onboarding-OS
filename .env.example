# Copy to .env.local and fill in. Vite only exposes VITE_-prefixed vars.

# GoHighLevel inbound webhook that receives owner invitations.
# In GHL: Automation -> Workflows -> new workflow -> Trigger "Inbound Webhook",
# copy the URL it gives you, then have the workflow create/update the contact
# and send the invitation email + SMS.
#
# Payload posted on each invite (JSON):
#   {
#     "officeName": "Kinsley Financial",
#     "officeId":   "kinsley",
#     "inviteLink": "https://.../j/kinsley",
#     "name":       "Jane Doe",
#     "email":      "jane@example.com",
#     "phone":      "(404) 555-0142",
#     "notes":      "Met at the Atlanta mixer"
#   }
VITE_GHL_INVITE_WEBHOOK=

# Webhook that receives a prospect's session registration from the public
# invitation form. Blank = reuse VITE_GHL_INVITE_WEBHOOK.
#
# Registration payload (sent when "Reserve my seat" is clicked):
#   {
#     "event":         "registration",
#     "fullName":      "Jane Doe",
#     "phone":         "(404) 555-0142",
#     "email":         "jane@example.com",
#     "sessionChosen": "Sun · Aug 9 · 6:00 PM ET · Zoom",
#     "referredBy":    "Kinsley Adair",
#     "officeName":    "Kinsley Financial",
#     "officeId":      "kinsley"
#   }
VITE_GHL_REGISTRATION_WEBHOOK=

# Webhook that receives contracts going out for signature.
# Leave blank to reuse VITE_GHL_INVITE_WEBHOOK — every payload carries an
# "event" field ("invite" or "contract") so one workflow can branch on it.
#
# Contract payload:
#   {
#     "event":           "contract",
#     "officeName":      "Kinsley Financial",
#     "officeId":        "kinsley",
#     "name":            "Jane Doe",
#     "email":           "jane@example.com",
#     "phone":           "(404) 555-0142",
#     "signLink":        "https://.../sign/9f2c…",
#     "contractName":    "Independent Contractor Agreement",
#     "contractVersion": "2026.1",
#     "sentBy":          "Kinsley Adair"
#   }
VITE_GHL_CONTRACT_WEBHOOK=

# Contract reminders (12h / 24h / 48h). Falls back to the contract hook.
VITE_GHL_REMINDER_WEBHOOK=

# Contract signed. Falls back to the contract hook.
VITE_GHL_SIGNED_WEBHOOK=

# ── AI assistant (Groq — open-weight models) ───────────
# Preferred: a server route that holds the key and forwards to Groq.
VITE_AI_PROXY_URL=
# Direct from the browser. Simple to demo, but the key ships in the bundle
# and anyone with devtools can read and spend it. Use a capped throwaway key.
VITE_GROQ_API_KEY=
VITE_GROQ_MODEL=llama-3.3-70b-versatile

# ── Supabase ──────────────────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Server-side only. Never prefix with VITE_.
# SUPABASE_SECRET_KEY=
